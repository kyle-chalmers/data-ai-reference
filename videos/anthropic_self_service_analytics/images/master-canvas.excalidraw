    {
      "type": "text",
      "id": "cva_row1_coding",
      "x": 330,
      "y": 507,
      "width": 540,
      "height": 190,
      "text": "Codebases are usually well\ndocumented: READMEs, types,\ndocstrings, commit history give\nreal, structured context.",
      "originalText": "Codebases are usually well\ndocumented: READMEs, types,\ndocstrings, commit history give\nreal, structured context.",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#e5e5e5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 900009,
      "version": 1,
      "versionNonce": 910009,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "cva_row1_analytics",
      "x": 970,
      "y": 507,
      "width": 540,
      "height": 190,
      "text": "A warehouse often has millions\nof undocumented fields. The\nsame metric gets defined\ndifferently by different teams.",
      "originalText": "A warehouse often has millions\nof undocumented fields. The\nsame metric gets defined\ndifferently by different teams.",
