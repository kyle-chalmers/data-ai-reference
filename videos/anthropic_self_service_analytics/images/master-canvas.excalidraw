    {
      "type": "text",
      "id": "cva_row3_coding",
      "x": 330,
      "y": 909,
      "width": 540,
      "height": 210,
      "text": "Compilers, linters, and unit tests\ngive fast, deterministic feedback\non whether the code is right.",
      "originalText": "Compilers, linters, and unit tests\ngive fast, deterministic feedback\non whether the code is right.",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#e5e5e5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
