    {
      "type": "text",
      "id": "cva_row2_coding",
      "x": 330,
      "y": 709,
      "width": 540,
      "height": 190,
      "text": "Most specs admit many correct\nimplementations, so a plausible\nanswer is usually a valid one.",
      "originalText": "Most specs admit many correct\nimplementations, so a plausible\nanswer is usually a valid one.",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#e5e5e5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 900014,
      "version": 1,
      "versionNonce": 910014,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "cva_row2_analytics",
      "x": 970,
      "y": 709,
      "width": 540,
      "height": 190,
      "text": "Writing the query is often trivial,\na few lines of SQL, but usually\nonly ONE approach is correct.",
      "originalText": "Writing the query is often trivial,\na few lines of SQL, but usually\nonly ONE approach is correct.",
