      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Priya: the QBR is in three\nweeks and Sanjay wants churn\nbroken out by region.\n\nMarcus: by region meaning the\nsales regions or the billing\nregions? Those don't line up.\n\nPriya: I think sales regions.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Priya: the QBR is in three\nweeks and Sanjay wants churn\nbroken out by region.\n\nMarcus: by region meaning the\nsales regions or the billing\nregions? Those don't line up.\n\nPriya: I think sales regions.",
      "lineHeight": 1.4
    },
