   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "roundness": null,
   "seed": 68246,
   "text": "A SECOND GATE, IF YOUR TOOL SENDS A BOT",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "version": 1,
   "versionNonce": 14013,
   "isDeleted": false,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "type": "text",
   "id": "cg_b",
   "x": 1285,
   "y": 552,
   "width": 342.0,
   "height": 168.8,
   "angle": 0,
   "strokeColor": "#e5e5e5",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "roundness": null,
   "seed": 90232,
   "text": "Teams now sends detected notetaker\nbots to the lobby by default. Meet\nauto-denies them under Restricted\naccess. A notetaker that worked last\nyear can quietly stop showing up.\n\nTools that capture system audio have\nnothing to block \u2014 and nothing appears\nin the participant list either.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "version": 1,
   "versionNonce": 62786,
   "isDeleted": false,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "type": "text",
   "id": "cg_f",
   "x": 1285,
   "y": 742,
   "width": 378.0,
   "height": 18.8,
