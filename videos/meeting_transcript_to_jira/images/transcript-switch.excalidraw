   "y": 232,
   "width": 306.0,
   "height": 106.2,
   "angle": 0,
   "strokeColor": "#0a0a0a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "roundness": null,
   "seed": 33828,
   "text": "These settings lock on at the\naccount or workspace level, so\none five-minute request covers\nevery meeting after it \u2014 not\njust the next one.",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "version": 1,
   "versionNonce": 32574,
   "isDeleted": false,
   "groupIds": [],
   "frameId": null,
   "boundElements": null,
